# TASKNOVA AI — Server Environment Configuration Template
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=tasknova-secret-key-change-in-production-2026

# ==============================================================================
# SUPABASE LIVE DATABASE & AUTHENTICATION (OPTIONAL)
# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, TASKNOVA automatically
# switches from LocalStore JSON mode to Supabase PostgreSQL with RLS.
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# AI LLM PLANNER CONFIGURATION (OPTIONAL)
# When set, uses Gemini/OpenAI for natural language task planning.
# Defaults to deterministic template planner when blank.
# ==============================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=
